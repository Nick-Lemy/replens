PORT=3000
HOST=127.0.0.1
# API documentation is enabled locally by default; set false to hide /api/docs.
API_DOCS_ENABLED=true
DATABASE_URL=postgresql://replens:replace-with-local-password@127.0.0.1:55434/replens
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional transactional email access. Leave both blank to keep email actions unavailable.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Google OAuth Web client. Leave both blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact proxy IPs/CIDRs; leave empty for direct local requests.
TRUSTED_PROXY_CIDRS=

# Development Compose database only; use same password in DATABASE_URL.
POSTGRES_PASSWORD=
