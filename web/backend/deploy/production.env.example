# Public API hostname. Point its DNS A record at this VPS.
API_HOST=

# Defaults to all host interfaces in production; use 127.0.0.1 for local smoke.
PUBLIC_BIND_ADDRESS=0.0.0.0

# Exact public frontend origin served by Netlify. The browser uses its same-origin
# /api proxy, so Better Auth's public URL and trusted origin are this value.
FRONTEND_ORIGIN=

# Use a URL-safe random value (for example: openssl rand -hex 32).
BETTER_AUTH_SECRET=

# Choose a URL-safe password and use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
# Set DATABASE_URL using this internal service host and the same URL-safe password:
# postgresql://replens:<URL-safe-password>@db:5432/replens?schema=public
DATABASE_URL=

# Leave both blank until a verified Resend sender/domain is configured.
RESEND_API_KEY=
EMAIL_FROM=

# Update this for each deployment to retain versioned images for rollback.
DEPLOY_VERSION=local

# Production docs are disabled by default. Set true only for controlled access.
API_DOCS_ENABLED=false

# Defaults are isolated in a private Docker network; change if they overlap
# another host network. Keep CADDY_EDGE_IP equal to the Caddy static address.
EDGE_SUBNET=172.29.240.0/24
CADDY_EDGE_IP=172.29.240.2
API_EDGE_IP=172.29.240.3
